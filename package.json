{
  "name": "neuruh-web",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "engines": { "node": ">=20.9.0" },
  "scripts": {
    "dev": "next dev apps/neuruh-web -p 4311",
    "build": "next build apps/neuruh-web",
    "start": "next start apps/neuruh-web -H 127.0.0.1 -p 4311",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:smoke": "playwright test apps/neuruh-web/tests/production.smoke.spec.ts",
    "test:canary": "node --test tests/budget-canary.test.mjs",
    "verify:provenance": "node scripts/verify-provenance.mjs",
    "verify:boundaries": "node scripts/verify-boundaries.mjs",
    "verify": "npm run typecheck && npm test && npm run verify:provenance && npm run verify:boundaries && npm run build",
    "bench:spike1": "bash packages/testing/run-resumable.sh",
    "aggregate:spike1": "node packages/testing/aggregate.mjs"
  },
  "dependencies": {
    "@react-three/drei": "10.7.7",
    "@react-three/fiber": "9.7.0",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@gltf-transform/cli": "4.4.2",
    "@gltf-transform/core": "4.4.2",
    "@gltf-transform/extensions": "4.4.2",
    "@gltf-transform/functions": "4.4.2",
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/three": "0.185.3",
    "typescript": "5.9.3"
  }
}
